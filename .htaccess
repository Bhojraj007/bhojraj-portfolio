# ==============================================================================
# LiteSpeed Web Server Configuration & Security Hardening (.htaccess)
# Domain: rajabhoj.com.np
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Force HTTPS (Server-Level 301 Permanent Redirect)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Check both direct HTTPS and proxy/CDN SSL termination headers
    RewriteCond %{HTTPS} !=on [NC]
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ------------------------------------------------------------------------------
# 2. Server Banner & Fingerprint Disclosure Reduction
# ------------------------------------------------------------------------------
ServerSignature Off

<IfModule mod_headers.c>
    # Strip or hide server banners and platform signatures
    Header unset Server
    Header always unset Server
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # --------------------------------------------------------------------------
    # 3. Security Headers (Defense-in-depth for static & error pages)
    # --------------------------------------------------------------------------
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# ------------------------------------------------------------------------------
# 4. Block Sensitive Files, Databases & Hidden Dotfiles
# ------------------------------------------------------------------------------
<FilesMatch "(^#.*#|\.(bak|conf|dist|fla|in[ci]|log|psd|sh|sql|sw[op]|env|sqlite3|py|git)|db\.sqlite3)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

